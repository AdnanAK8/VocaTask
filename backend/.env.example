# VoiceTasks AI Backend Configuration
# Add your API keys below for cloud STT and LLM parsing.
# (If left empty, the server automatically uses the built-in intelligent multilingual heuristic parser!)

# Gemini API Key (Recommended for smart multilingual parsing)
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Groq API Key (Alternative for ultra-fast Whisper-large-v3 and Llama-3.3-70b)
GROQ_API_KEY=replace-with-your-groq-api-key

# OpenAI API Key (Alternative for Whisper and GPT-4o-mini)
OPENAI_API_KEY=replace-with-your-openai-api-key

ELEVEN_LAB_API_KEY=replace-with-your-elevenlabs-api-key
# Timezone (Default for resolving relative words like "kal", "shaam")
DEFAULT_TIMEZONE=Asia/Kolkata

# PostgreSQL connection (local SSH tunnel defaults)
# Set DATABASE_URL instead if you prefer a PostgreSQL URL.
DATABASE_URL=
PGHOST=localhost
PGPORT=5433
PGDATABASE=vocatask
PGUSER=vocatask_user
PGPASSWORD=replace-with-your-database-password
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_TIMEOUT=10

# Allowed CORS Origins (JSON array of allowed frontend URLs)
# Add your deployed AWS Amplify domain, S3/CloudFront URL, or custom domain here.
# Example: ["https://main.d123456abcdef.amplifyapp.com", "https://d123456abcdef.cloudfront.net", "http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Authentication & OAuth Credentials
JWT_SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
